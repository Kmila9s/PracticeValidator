<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kmila.Tools.PracticeValidator</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS1998;NETSDK1206</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test kit (practice oracle: harness generator + reference simulator)
         and, through it, Kmila.Shared (PracticeCatalog, PracticeEvaluator).
         Path relative to this csproj at the repo top level. -->
    <ProjectReference Include="../App/Kmila/Kmila.TestKit/Kmila.TestKit.csproj" />
  </ItemGroup>

</Project>
