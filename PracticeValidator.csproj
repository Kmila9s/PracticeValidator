<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kmila.Tools.PracticeValidator</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;CS1998;NETSDK1206</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The validator references the app's Kmila.Shared (net9.0 head) for
         PracticeCatalog, PracticeEvaluator, models, and the simulation
         pipeline they wrap. Path is relative to this csproj at the repo
         top level. -->
    <ProjectReference Include="../App/Kmila/Kmila.Shared/Kmila.Shared.csproj" />
  </ItemGroup>

</Project>
